# Supabase (optional — app runs on mock providers without these)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Show Integrations / provider plug-in panel in Profile
EXPO_PUBLIC_PROVIDER_PANEL=1
EXPO_PUBLIC_FEATURE_SMART_ITINERARY_V2=1
EXPO_PUBLIC_FEATURE_VIATOR_V2=1
EXPO_PUBLIC_FEATURE_SUPABASE_COLLABORATION=1
EXPO_PUBLIC_FEATURE_TRIP_WIZARD_V2=1
EXPO_PUBLIC_FEATURE_COLLECTIONS_V1=1

# Per-slot provider selection: mock | supabase | <plugin-id>
GAYI_PROVIDER_DESTINATIONS=mock
GAYI_PROVIDER_PLACES=mock
GAYI_PROVIDER_EVENTS=mock
GAYI_PROVIDER_LGBTQCONTEXT=mock
GAYI_PROVIDER_COMMUNITYSIGNALS=mock
GAYI_PROVIDER_WEATHER=mock
GAYI_PROVIDER_FLIGHTS=mock
GAYI_PROVIDER_LODGING=mock
GAYI_PROVIDER_CURRENCY=mock
GAYI_PROVIDER_MAPS=mock
GAYI_PROVIDER_TRIPS=mock
GAYI_PROVIDER_AUTH=mock
GAYI_PROVIDER_AI=mock
GAYI_PROVIDER_ANALYTICS=supabase
GAYI_PROVIDER_SHARE=native-share
GAYI_PROVIDER_EVENTINVITATION=partiful-handoff
GAYI_PROVIDER_IMAGES=mock
GAYI_PROVIDER_NOTIFICATIONS=noop
GAYI_PROVIDER_EXPERIENCES=mock

# The native Maps SDK key is the only Google credential allowed in the app bundle.
# Google web-service and Viator secrets belong in Supabase Edge Function secrets.
# After editing, restart: cd apps/mobile && npx expo start --go --clear
# Confirm Metro logs: [gayi] integrations configured — maps-sdk:true places-proxy:true viator-proxy:true
GETYOURGUIDE_API_KEY=
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_APP_DOMAIN=gayi.expo.app
# Server-only: set with `supabase secrets set`, never prefix these with EXPO_PUBLIC_.
VIATOR_API_KEY=
GOOGLE_PLACES_API_KEY=
# Server-only image search. Also set this as a Supabase Edge Function secret.
PEXELS_API_KEY=
APP_PUBLIC_URL=https://gayi.expo.app
TICKETMASTER_API_KEY=
NPS_API_KEY=
OPEN_METEO_API_KEY=
# Booking.com Demand API credentials (server-only). Use the sandbox base URL while validating access.
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi.booking.com/3.2
# Skyscanner partner key (server-only).
SKYSCANNER_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
OPENAI_API_KEY=
OPENAI_BASE_URL=
MAPBOX_ACCESS_TOKEN=
# Server-only analytics forwarding and internal-only native replay.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_FORWARD_SECRET=
ANALYTICS_HASH_SECRET=
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_INTERNAL_ANALYTICS_BUILD=0
EXPO_PUBLIC_SESSION_REPLAY_ENABLED=0
SENTRY_DSN=
WEATHER_API_KEY=
FX_API_KEY=

# Equaldex live API — keep OFF until a commercial license is obtained
# (API terms are non-commercial-only by default). Prefer equaldex-cited fixtures.
EQUALDEX_API_KEY=
GAYI_ENABLE_EQUALDEX_LIVE=0
